{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "5ad9e6fff6d12d1ceaa3e51c2f11c64d8688b2da",
  "packages": {
    ".": {
      "release-type": "simple",
      "version-file": "VERSION",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'vigil-core' || @.name.value == 'vigild' || @.name.value == 'vigilctl')].version"
        },
        {
          "type": "generic",
          "path": "packaging/vigil.spec"
        }
      ]
    }
  }
}
